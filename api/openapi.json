    "/v1/package-searches": {
      "post": {
        "operationId": "searchPackage",
        "summary": "パッケージ名とベンダー名からCPE/PURLを検索・推論",
        "responses": {
          "202": {
            "description": "非同期ジョブを受理。冪等な再送も同じジョブを返す。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "ジョブ状態URL",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "推奨ポーリング間隔（秒）",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "405": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageSearchRequest"
              },
              "example": {
                "name": "log4j-core",
                "vendor": "Apache Software Foundation",
                "options": {
                  "provider": "openai",
                  "model": "SERVER_ALLOWED_MODEL_ID"
                }
              }
            }
          }
        },
        "description": "SBOM不要。内部でcomponent-1の単一パッケージジョブに変換し、202でJobを返す。結果は既存のresolutions APIで取得する。"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Provider": {
        "type": "string",
        "enum": [
          "openai",
          "gemini",
          "claude",
          "deepseek"
        ]
      },
      "Package": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "vendor": {
            "type": "string",
            "maxLength": 512
          },
          "version": {
            "type": "string",
            "maxLength": 256
          },
          "ecosystem": {
            "type": "string",
            "maxLength": 128
          },
          "namespace": {
            "type": "string",
            "maxLength": 512
          },
          "repository_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "existing_cpes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "existing_purls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PackageInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "packages"
            ]
          },
          "packages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Package"
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "kind",
          "packages"
        ]
      },
      "SBOMInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sbom"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "cyclonedx",
              "spdx"
            ]
          },
          "document": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "kind",
          "format",
          "document"
        ]
      },
      "Options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cpe",
                "purl"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "default": [
              "cpe",
              "purl"
            ]
          },
          "max_candidates": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 5
          }
        },
        "required": [
          "provider",
          "model"
        ]
      },
      "CreateResolution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PackageInput"
              },
              {
                "$ref": "#/components/schemas/SBOMInput"
              }
            ],
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "packages": "#/components/schemas/PackageInput",
                "sbom": "#/components/schemas/SBOMInput"
              }
            }
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          }
        },
        "required": [
          "input",
          "options"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pointer": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "message"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ]
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "calls": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "calls"
        ]
      },
      "RunMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_sha256": {
            "type": "string"
          },
          "config_sha256": {
            "type": "string"
          },
          "prompt_version": {
            "type": "string"
          },
          "rule_version": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "entrypoint": {
            "type": "string",
            "enum": [
