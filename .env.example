# Example placeholders only. Replace with separate random secrets before use.
GOCPE_API_TOKENS='{"replace-with-random-token-at-least-32-bytes":"local-user"}'
GOCPE_CURSOR_KEY='replace-with-separate-random-secret-at-least-32-bytes'

# Optional PostgreSQL connection; use -migrate explicitly on first start.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gocpe

# Optional NVD API key. Leave empty to use the public unauthenticated rate limit.
NVD_API_KEY=
