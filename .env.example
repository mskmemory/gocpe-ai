# Example placeholders only. Replace with separate random secrets before use.
GOCPE_API_TOKENS='{"replace-with-random-token-at-least-32-bytes":"local-user"}'
GOCPE_CURSOR_KEY='replace-with-separate-random-secret-at-least-32-bytes'

# Optional PostgreSQL connection; use -migrate explicitly on first start.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gocpe

# AI adapters only; API startup does not connect these yet.
OPENAI_API_KEY=replace-with-api-key
OPENAI_MODEL=replace-with-supported-model-id
GEMINI_API_KEY=replace-with-api-key
GEMINI_MODEL=replace-with-supported-model-id
ANTHROPIC_API_KEY=replace-with-api-key
ANTHROPIC_MODEL=replace-with-supported-model-id
DEEPSEEK_API_KEY=replace-with-api-key
DEEPSEEK_MODEL=replace-with-supported-model-id
